# ==============================================================================
# VAJRA PLATFORM: ENVIRONMENT CONFIGURATION TEMPLATE
# For code review and offline deployment evaluation.
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Database storage (SQLite relational engine)
DATABASE_URL=sqlite:///./vajra.db

# Cryptographic Token Signing Secret (Replace with a secure random key)
SECRET_KEY=change-in-production-secure-random-vajra-key

# JWT Token Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational Toggles
ML_ENABLED=true
OFFLINE_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Path to read-only ingestion CSVs
DATA_DIR=data

# Live Simulation Settings
SIMULATOR_SPEED=1.0
LOG_LEVEL=INFO

# Optional: Default user seed passwords (fallback to demo credentials if unset)
DEFAULT_COMMANDER_PASSWORD=Commander@123
DEFAULT_OFFICER_PASSWORD=Officer@123
DEFAULT_ANALYST_PASSWORD=Analyst@123
